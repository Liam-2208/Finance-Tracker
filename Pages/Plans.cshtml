@page "/plans"
@model PlansModel
@{
    ViewData["Title"] = "Free plan";
    ViewData["Description"] = "Finance Freedom's free, ad-supported tools for tracking spending, setting budgets and planning savings.";
}

<div class="container plans-shell py-5">
    <div class="plans-intro text-center">
        <span class="section-kicker">SIMPLE, TRANSPARENT ACCESS</span>
        <h1>Money tools, free to use.</h1>
        <p>Finance Freedom is currently funded by ads on public educational pages.</p>
    </div>

    @if (Model.PaymentStatus == "success")
    {
        <div class="billing-notice">Your existing subscription is being updated. Check your account in a moment.</div>
    }
    else if (Model.BillingStatus == "setup-needed")
    {
        <div class="billing-notice billing-notice-warn">Online payments are not part of the current launch plan. You can use Finance Freedom for free.</div>
    }

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <section class="plan-card h-100">
                <div class="plan-label">AD-SUPPORTED ACCESS</div>
                <h2>Free</h2>
                <div class="plan-price">£0 <span>forever</span></div>
                <p class="plan-summary">The full set of core tools for planning and understanding your money.</p>
                <ul class="plan-features">
                    <li>Weekly and monthly income and spending</li>
                    <li>Add, edit, and delete transactions</li>
                    <li>Category spending charts and unlimited budgets</li>
                    <li>Monthly savings estimates</li>
                    <li>CSV export of your transactions</li>
                    <li>Private account with data deletion controls</li>
                    <li>Ads appear on public money guides, not beside your personal finance figures</li>
                </ul>
                @if (Model.Account is null)
                {
                    <a class="btn plan-free-button w-100" asp-page="/Account/Register">Create a free account</a>
                }
                else
                {
                    <a class="btn plan-free-button w-100" asp-page="/Index">Go to your overview</a>
                }
                @if (Model.Account?.IsPlus == true)
                {
                    <div class="plan-current mt-3">Your account has an existing Plus subscription. <a asp-page="/Account/Manage">Manage it in account settings.</a></div>
                }
            </section>
        </div>
    </div>
    <p class="plans-footnote">No payment card is needed for the free plan. Ad delivery depends on site approval, consent choices, and availability.</p>
</div>
