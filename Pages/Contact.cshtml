@page "/contact"
@{
    ViewData["Title"] = "Contact us";
    ViewData["Description"] = "Get help with Finance Freedom. Contact our support email for account or website issues.";
}
<div class="container contact-shell py-5">
    <section class="contact-hero">
        <div class="contact-orb" aria-hidden="true"></div>
        <span class="section-kicker">HERE WHEN YOU NEED US</span>
        <h1>Let’s get things<br /><span>sorted.</span></h1>
        <p>If something isn’t working as expected, send us a note. Tell us what happened and we’ll help you get back on track.</p>
        <a class="btn contact-cta" href="mailto:Zection6@gmail.com?subject=Finance%20Freedom%20support">Email support <span aria-hidden="true">↗</span></a>
    </section>
    <div class="contact-details">
        <div class="contact-detail-icon" aria-hidden="true">✉</div>
        <div><span class="section-kicker">EMAIL SUPPORT</span><h2>Tell us how we can help</h2><p>For account, transaction, or website problems, contact us directly at:</p><a class="contact-email" href="mailto:Zection6@gmail.com">Zection6@gmail.com</a></div>
    </div>
    <div class="contact-note"><span aria-hidden="true">ⓘ</span><p>Please don’t email passwords, bank login details, card numbers, or other sensitive financial information. A short description of the issue is enough to get started.</p></div>
</div>
